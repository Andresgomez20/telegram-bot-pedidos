# Copia este archivo como .env. El .env NUNCA se sube a git.

# Token que te da @BotFather en Telegram al crear el bot
TELEGRAM_TOKEN=

# Chat id del dueño del negocio, para avisarle de cada pedido.
# Para saberlo: arranca el bot, escríbele /miid desde la cuenta del dueño y pega el número aquí.
TELEGRAM_CHAT_DUENO=

ARCHIVO_PEDIDOS=datos/pedidos.json
